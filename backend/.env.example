# Reference values only. Spring Boot does not load this file automatically.
DB_URL=jdbc:mysql://localhost:3306/jalachaya?sslMode=REQUIRED&serverTimezone=UTC
DB_USERNAME=jalachaya
DB_PASSWORD=replace-with-your-private-database-password
JWT_SECRET=replace-with-at-least-32-private-utf8-bytes
FRONTEND_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
UPLOAD_DIR=./uploads

# Start ai-service first, then enable Java's AI job processor.
AI_ENABLED=true
AI_SERVICE_URL=http://localhost:8000
AI_BACKEND_URL=http://localhost:8080
AI_TIMEOUT_MS=15000
AI_POLL_MS=10000

# The local launcher enables labelled judge accounts. Java alone defaults to false.
ENABLE_JUDGE_DEMO=false
DEMO_SAMPLES_DIR=../assets/samples
